{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@parlour/engine": ["./vendor/packages/engine/src/index.ts"]
    }
  },
  "include": ["facade", "tests", "vendor/packages/*/src", "terminal/src", "terminal/tests", "persistence"]
}
