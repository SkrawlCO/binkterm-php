{#
    Experience library card.

    public_mode (default false): anonymous discovery rendering. In public mode
    the card is a discovery object only — the title is not a link, the primary
    action never points at the authenticated /experiences/{id} lobby, and no
    viewer/participation state is shown. The `view` it receives in public mode
    is ExperiencePresentation::buildPublic() output, which already carries no
    identity-bearing fields.
#}
{% set public_mode = public_mode|default(false) %}
{% set view = game.experience_presentation %}
{% set status = view.status.code %}
{% set card_muted = status == 'planned' or status == 'unavailable' %}
{% set has_metadata = view.capacity.at_capacity
    or view.runtime.player_count > 0
    or (view.capabilities.multiplayer and not public_mode)
    or not view.cost.free %}
<div class="col"
     data-experience-filter-item
     data-filter-name="{{ view.name }}"
     data-filter-description="{{ view.description }}"
     data-filter-player-count="{{ view.runtime.player_count|default(0) }}"
     data-filter-multiplayer="{{ view.capabilities.multiplayer ? '1' : '0' }}"
     data-filter-web="{{ view.surfaces.web }}"
     data-filter-telnet="{{ view.surfaces.telnet }}">
    <article class="card experience-library-card h-100 mb-0{% if card_muted %} experience-library-card--muted{% endif %}">
        <div class="card-body experience-card-layout">
            <div class="experience-card-identity d-flex gap-2">
                <img class="experience-card-icon flex-shrink-0" width="48" height="48" src="{{ view.presentation.icon_url|default('/favicon.svg') }}" alt="" onerror="this.src='/favicon.svg'">
                <div class="min-w-0 flex-grow-1">
                    <h3 class="h5 mb-1">{% if public_mode %}{{ view.name }}{% else %}<a href="/experiences/{{ view.id }}" class="experience-title-link">{{ view.name }}</a>{% endif %}</h3>
                    <div class="experience-card-taxonomy small text-muted">
                        {% if view.category == 'game' %}{{ t('ui.webdoors.category_game', {}, locale, ['common']) }}{% elseif view.category == 'gateway' %}{{ t('ui.webdoors.category_gateway', {}, locale, ['common']) }}{% else %}{{ view.category|capitalize }}{% endif %} · {% if view.capabilities.multiplayer %}{{ t('ui.webdoors.multiplayer', {}, locale, ['common']) }}{% else %}{{ t('ui.webdoors.single_player', {}, locale, ['common']) }}{% endif %}
                    </div>
                </div>
            </div>

            <p class="experience-card-description text-muted small mb-0">{{ view.description }}</p>

            {% if has_metadata %}
            <div class="experience-metadata-cluster small">
                {%- if view.capacity.at_capacity -%}
                <span class="experience-metadata-token experience-presence experience-presence--full" data-experience-id="{{ view.id }}" aria-live="polite"><i class="fas fa-circle experience-presence-dot--full me-1" aria-hidden="true"></i><span>{{ t('ui.webdoors.full_capacity', {}, locale, ['common']) }}{% if view.capacity.max_sessions %} · {{ view.runtime.session_count }}/{{ view.capacity.max_sessions }}{% endif %}</span></span>
                {%- elseif view.runtime.player_count > 0 -%}
                <span class="experience-metadata-token experience-presence" data-experience-id="{{ view.id }}" aria-live="polite"><i class="fas fa-circle text-success me-1" aria-hidden="true"></i><span>{{ t('ui.webdoors.players_online', {'count': view.runtime.player_count}, locale, ['common']) }}{% if view.capacity.max_sessions %} · {{ view.runtime.session_count }}/{{ view.capacity.max_sessions }}{% endif %}</span></span>
                {%- elseif view.capabilities.multiplayer and not public_mode -%}
                <span class="experience-metadata-token experience-presence d-none" data-experience-id="{{ view.id }}" aria-live="polite"><i class="fas fa-circle text-success me-1" aria-hidden="true"></i><span></span></span>
                {%- endif -%}
                {%- if not view.cost.free -%}
                <span class="experience-metadata-token experience-cost-token">{{ t('ui.webdoors.credit_cost', {'count': view.cost.credits}, locale, ['common']) }}</span>
                {%- endif -%}
            </div>
            {% endif %}

            <div class="experience-card-footer d-flex justify-content-end align-items-center">
                {%- if public_mode -%}
                    {%- if status == 'available' -%}
                    <a href="/login" class="btn btn-fidonet btn-sm experience-card-action">{{ t('ui.discovery.sign_in_to_play', {}, locale, ['common']) }}</a>
                    {%- elseif status == 'at_capacity' -%}
                    <span class="btn btn-outline-secondary btn-sm experience-card-action disabled" aria-disabled="true">{{ t('ui.webdoors.full_capacity', {}, locale, ['common']) }}</span>
                    {%- elseif status == 'planned' -%}
                    <span class="btn btn-outline-secondary btn-sm experience-card-action disabled" aria-disabled="true">{{ t('ui.webdoors.coming_soon', {}, locale, ['common']) }}</span>
                    {%- elseif view.surfaces.telnet == 'full' -%}
                    <span class="experience-card-note text-muted small">{{ t('ui.webdoors.terminal_only', {}, locale, ['common']) }}</span>
                    {%- else -%}
                    <span class="experience-card-note text-muted small">{{ t('ui.webdoors.surface_unavailable', {}, locale, ['common']) }}</span>
                    {%- endif -%}
                {%- elseif status == 'participating' -%}
                <a href="/experiences/{{ view.id }}" class="btn btn-fidonet btn-sm experience-card-action">{{ t('ui.webdoors.return', {}, locale, ['common']) }}</a>
                {%- elseif status == 'available' -%}
                <a href="/experiences/{{ view.id }}" class="btn btn-fidonet btn-sm experience-card-action">{{ t('ui.webdoors.enter', {}, locale, ['common']) }}</a>
                {%- elseif status == 'at_capacity' -%}
                <span class="btn btn-outline-secondary btn-sm experience-card-action disabled" aria-disabled="true">{{ t('ui.webdoors.full_capacity', {}, locale, ['common']) }}</span>
                {%- elseif status == 'planned' -%}
                <span class="btn btn-outline-secondary btn-sm experience-card-action disabled" aria-disabled="true">{{ t('ui.webdoors.coming_soon', {}, locale, ['common']) }}</span>
                {%- elseif view.surfaces.telnet == 'full' -%}
                <span class="experience-card-note text-muted small">{{ t('ui.webdoors.terminal_only', {}, locale, ['common']) }}</span>
                {%- else -%}
                <span class="experience-card-note text-muted small">{{ t('ui.webdoors.surface_unavailable', {}, locale, ['common']) }}</span>
                {%- endif -%}
            </div>
        </div>
    </article>
</div>
