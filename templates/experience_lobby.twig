{% extends "base.twig" %}

{% block title %}{{ experience.name }} - {{ system_name }}{% endblock %}

{% block content %}
<div class="container py-4">

    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-8">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    {% if experience.presentation.screenshot_url %}
                        <div class="mb-4">
                            <img
                                src="{{ experience.presentation.screenshot_url }}"
                                alt="{{ experience.name }} screenshot"
                                class="img-fluid rounded border w-100"
                                style="max-height: 520px; object-fit: contain;"
                            >
                        </div>
                    {% endif %}

                    <div class="d-flex align-items-start gap-3 mb-4">
                        <img
                            src="{{ experience.presentation.icon_url|default('/favicon.svg') }}"
                            alt="{{ experience.name }}"
                            class="rounded"
                            style="width: 96px; height: 96px; object-fit: cover;"
                            onerror="this.src='/favicon.svg'"
                        >

                        <div class="flex-grow-1">
                            <h1 class="h3 mb-1">{{ experience.name }}</h1>

                            {% if experience.author or experience.version %}
                                <div class="text-muted small mb-2">
                                    {% if experience.version %}v{{ experience.version }}{% endif %}
                                    {% if experience.version and experience.author %} · {% endif %}
                                    {% if experience.author %}by {{ experience.author }}{% endif %}
                                </div>
                            {% endif %}

                            <p class="text-muted mb-3">
                                {{ experience.description }}
                            </p>

                            <div class="d-flex flex-wrap gap-2">
                                {% if experience.capabilities.multiplayer %}
                                    <span class="badge bg-secondary-subtle text-dark border">
                                        <i class="fas fa-users me-1" aria-hidden="true"></i>
                                        Multiplayer
                                    </span>
                                {% else %}
                                    <span class="badge bg-secondary-subtle text-dark border">
                                        <i class="fas fa-user me-1" aria-hidden="true"></i>
                                        Single Player
                                    </span>
                                {% endif %}

                                {% set max_sessions = experience.capacity.max_sessions|default(null) %}
                                {% if max_sessions %}
                                    <span class="badge bg-secondary-subtle text-dark border">
                                        <i class="fas fa-server me-1" aria-hidden="true"></i>
                                        Capacity: {{ max_sessions }}
                                    </span>
                                {% endif %}

                                {% set credit_cost = experience.policy.credit_cost|default(0) %}
                                {% if credit_cost > 0 %}
                                    <span class="badge bg-secondary-subtle text-dark border">
                                        <i class="fas fa-coins me-1" aria-hidden="true"></i>
                                        {{ credit_cost }} credit{% if credit_cost != 1 %}s{% endif %}
                                    </span>
                                {% else %}
                                    <span class="badge bg-secondary-subtle text-dark border">
                                        <i class="fas fa-ticket-alt me-1" aria-hidden="true"></i>
                                        Free to play
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <div class="border rounded p-3 mb-4">
                        {% set max_sessions = experience.capacity.max_sessions|default(null) %}

                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                            <div>
                                <div class="fw-semibold">
                                    <i class="fas fa-users me-1" aria-hidden="true"></i>
                                    Live Players
                                </div>
                                <div id="experience-player-summary" class="text-muted small">
                                    {% if state.player_count == 0 %}
                                        Waiting for players.
                                    {% elseif state.player_count == 1 %}
                                        1 player is in this Experience.
                                    {% else %}
                                        {{ state.player_count }} players are in this Experience.
                                    {% endif %}
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-2 justify-content-end">
                                <span id="experience-live-status"
                                      class="badge bg-success{% if state.session_count <= 0 %} d-none{% endif %}">
                                    <i class="fas fa-circle me-1" aria-hidden="true"></i>
                                    Live
                                </span>

                                <span id="experience-session-count"
                                      class="badge bg-secondary-subtle text-dark border">
                                    {{ state.session_count }}
                                    active session{% if state.session_count != 1 %}s{% endif %}
                                </span>

                                {% if max_sessions %}
                                    <span id="experience-capacity"
                                          data-max-sessions="{{ max_sessions|default(0) }}"
                                          class="badge bg-secondary-subtle text-dark border">
                                        {{ state.session_count }} / {{ max_sessions }} capacity
                                    </span>
                                {% endif %}
                            </div>
                        </div>

                        {% if max_sessions and max_sessions > 0 %}
                            <div id="experience-occupancy-container">
                                {% if state.session_count > 0 %}
                                    {% set occupancy_percent = ((state.session_count / max_sessions) * 100)|round %}
                                    <div id="experience-occupancy"
                                         class="progress mb-3"
                                         role="progressbar"
                                         aria-label="Experience capacity"
                                         aria-valuenow="{{ state.session_count }}"
                                         aria-valuemin="0"
                                         aria-valuemax="{{ max_sessions }}"
                                         style="height: 6px;">
                                        <div class="progress-bar"
                                             style="width: {{ occupancy_percent > 100 ? 100 : occupancy_percent }}%;">
                                        </div>
                                    </div>
                                {% endif %}
                            </div>
                        {% endif %}

                        <div id="experience-participants"
                             class="{% if state.players|length > 0 %}list-group{% else %}text-muted small{% endif %}">
                            {% if state.players|length > 0 %}
                                {% for player in state.players %}
                                    {% include 'partials/experience_participant.twig' with {
                                        player: player,
                                        experience: experience,
                                        current_user: current_user,
                                        participant_actions: experience.participant_actions|default({})
                                    } %}
                                {% else %}
                                    No one is playing right now. Be the first one in.
                                {% endfor %}
                            {% else %}
                                No one is playing right now. Be the first one in.
                            {% endif %}
                        </div>
                    </div>

                    <div class="border rounded p-3 mb-3">
                        <div class="fw-semibold mb-2">
                            <i class="fas fa-clock-rotate-left me-1" aria-hidden="true"></i>
                            Recent Activity
                        </div>

                        <div id="experience-recent-activity" class="small text-muted">
                            No recent activity yet.
                        </div>
                    </div>

                    {% set at_capacity = max_sessions and state.session_count >= max_sessions %}
                    {% set launch_supported = experience.actions.launch and launch %}
                    {% set credit_cost = experience.policy.credit_cost|default(0) %}

                    <div class="border rounded p-3 mb-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div>
                                <div class="fw-semibold">
                                    <i class="fas fa-circle-info me-1" aria-hidden="true"></i>
                                    Availability
                                </div>
                                <div id="experience-availability-message" class="text-muted small">
                                    {% if at_capacity %}
                                        This Experience is currently at capacity.
                                    {% elseif launch_supported %}
                                        Ready to launch.
                                    {% else %}
                                        Launch is not currently available from this surface.
                                    {% endif %}
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-2 justify-content-end">
                                <span id="experience-availability-badge"
                                      data-launch-supported="{{ launch_supported ? 'true' : 'false' }}"
                                      class="badge {% if at_capacity %}bg-warning text-dark{% elseif launch_supported %}bg-success{% else %}bg-secondary{% endif %}">
                                    {% if at_capacity %}
                                        At capacity
                                    {% elseif launch_supported %}
                                        Available
                                    {% else %}
                                        Unavailable
                                    {% endif %}
                                </span>

                                {% if credit_cost > 0 %}
                                    <span class="badge bg-secondary-subtle text-dark border">
                                        {{ credit_cost }} credit{% if credit_cost != 1 %}s{% endif %} per launch
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a href="/games" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-1" aria-hidden="true"></i>
                            Back to Games
                        </a>

                        <div class="d-flex align-items-center gap-2">
                            <button
                                id="experience-end-button"
                                type="button"
                                class="btn btn-outline-danger d-none"
                            >
                                <i class="fas fa-stop me-1" aria-hidden="true"></i>
                                End Participation
                            </button>

                            {% if launch_supported %}
                                <a id="experience-launch-button" href="{{ launch.url }}"
                                   class="btn btn-fidonet{% if at_capacity %} disabled{% endif %}"
                                   {% if at_capacity %}aria-disabled="true" tabindex="-1"{% endif %}>
                                    <i class="fas fa-play me-1" aria-hidden="true"></i>
                                    <span id="experience-launch-label">
                                        {% if at_capacity %}
                                            At Capacity
                                        {% else %}
                                            Play {{ experience.name }}
                                        {% endif %}
                                    </span>
                                </a>
                            {% endif %}
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

</div>
{% endblock %}

{% block scripts %}
<script>
const EXPERIENCE_ID = {{ experience.id|json_encode|raw }};
const EXPERIENCE_NAME = {{ experience.name|json_encode|raw }};

async function refreshExperienceState() {
    const response = await fetch(
        `/api/experiences/${encodeURIComponent(EXPERIENCE_ID)}/state`,
        { headers: { 'Accept': 'application/json' } }
    );

    if (!response.ok) {
        throw new Error(`Experience state request failed: ${response.status}`);
    }

    return response.json();
}

function updateExperiencePlayerSummary(state) {
    const summary = document.getElementById('experience-player-summary');
    if (!summary) return;

    const count = Number(state.player_count || 0);

    if (count === 0) {
        summary.textContent = 'Waiting for players.';
    } else if (count === 1) {
        summary.textContent = '1 player is in this Experience.';
    } else {
        summary.textContent = `${count} players are in this Experience.`;
    }
}

function escapeExperienceHtml(value) {
    const div = document.createElement('div');
    div.textContent = String(value ?? '');
    return div.innerHTML;
}

function updateExperienceLiveState(state, viewer = null) {
    const sessionCount = Number(state.session_count || 0);
    const viewerParticipating = !!(viewer && viewer.participating);

    const liveStatus = document.getElementById('experience-live-status');
    const sessionBadge = document.getElementById('experience-session-count');
    const capacityBadge = document.getElementById('experience-capacity');
    const availabilityMessage = document.getElementById('experience-availability-message');
    const availabilityBadge = document.getElementById('experience-availability-badge');
    const launchButton = document.getElementById('experience-launch-button');

    if (liveStatus) {
        liveStatus.classList.toggle('d-none', sessionCount <= 0);
    }

    if (sessionBadge) {
        sessionBadge.textContent =
            `${sessionCount} active session${sessionCount === 1 ? '' : 's'}`;
    }

    if (capacityBadge) {
        const maxSessions = Number(capacityBadge.dataset.maxSessions || 0);

        if (maxSessions > 0) {
            capacityBadge.textContent =
                `${sessionCount} / ${maxSessions} capacity`;
        }
    }

    const maxSessions = capacityBadge
        ? Number(capacityBadge.dataset.maxSessions || 0)
        : 0;

    const occupancyContainer = document.getElementById(
        'experience-occupancy-container'
    );

    let liveOccupancy = document.getElementById('experience-occupancy');

    if (occupancyContainer && maxSessions > 0) {
        if (sessionCount > 0) {
            const percent = Math.min(
                100,
                Math.round((sessionCount / maxSessions) * 100)
            );

            if (!liveOccupancy) {
                liveOccupancy = document.createElement('div');
                liveOccupancy.id = 'experience-occupancy';
                liveOccupancy.className = 'progress mb-3';
                liveOccupancy.setAttribute('role', 'progressbar');
                liveOccupancy.setAttribute(
                    'aria-label',
                    'Experience capacity'
                );
                liveOccupancy.setAttribute('aria-valuemin', '0');
                liveOccupancy.setAttribute(
                    'aria-valuemax',
                    String(maxSessions)
                );

                const bar = document.createElement('div');
                bar.className = 'progress-bar';
                liveOccupancy.appendChild(bar);
                occupancyContainer.appendChild(liveOccupancy);
            }

            liveOccupancy.setAttribute(
                'aria-valuenow',
                String(sessionCount)
            );

            const bar = liveOccupancy.querySelector('.progress-bar');
            if (bar) {
                bar.style.width = `${percent}%`;
            }
        } else if (liveOccupancy) {
            liveOccupancy.remove();
        }
    }

    const atCapacity = maxSessions > 0 && sessionCount >= maxSessions;
    const launchSupported = availabilityBadge &&
        availabilityBadge.dataset.launchSupported === 'true';

    if (availabilityMessage) {
        if (atCapacity) {
            availabilityMessage.textContent =
                'This Experience is currently at capacity.';
        } else if (launchSupported) {
            availabilityMessage.textContent =
                'Ready to launch.';
        } else {
            availabilityMessage.textContent =
                'Launch is not currently available from this surface.';
        }
    }

    if (availabilityBadge) {
        if (atCapacity) {
            availabilityBadge.className = 'badge bg-warning text-dark';
            availabilityBadge.textContent = 'At capacity';
        } else if (launchSupported) {
            availabilityBadge.className = 'badge bg-success';
            availabilityBadge.textContent = 'Available';
        } else {
            availabilityBadge.className = 'badge bg-secondary';
            availabilityBadge.textContent = 'Unavailable';
        }
    }

    if (launchButton) {
        const disabled =
            (atCapacity && !viewerParticipating) || !launchSupported;
        launchButton.classList.toggle('disabled', disabled);
        launchButton.setAttribute('aria-disabled', disabled ? 'true' : 'false');
        launchButton.tabIndex = disabled ? -1 : 0;

        if (!disabled) {
            const icon = launchButton.querySelector('i');

            if (icon) {
                icon.className = viewerParticipating
                    ? 'fas fa-sign-in-alt me-1'
                    : 'fas fa-play me-1';
            }

            const label = viewerParticipating
                ? `Return to ${EXPERIENCE_NAME}`
                : `Play ${EXPERIENCE_NAME}`;

            launchButton.setAttribute('aria-label', label);
            launchButton.dataset.viewerParticipating =
                viewerParticipating ? 'true' : 'false';

            const labelElement = document.getElementById(
                'experience-launch-label'
            );

            if (labelElement) {
                labelElement.textContent = label;
            }
        }
    }
}

function renderExperienceParticipants(state, actions) {
    const container = document.getElementById('experience-participants');
    if (!container) return;

    const players = Array.isArray(state.players) ? state.players : [];
    const profileEnabled = !!(actions && actions.profile);
    const messageEnabled = !!(actions && actions.message);

    if (players.length === 0) {
        container.className = 'text-muted small';
        container.textContent = 'No one is playing right now. Be the first one in.';
        return;
    }

    container.className = 'list-group';

    container.innerHTML = players.map(player => {
        const userId = Number(player.user_id || 0);
        const username = escapeExperienceHtml(player.username);
        const presence = player.presence
            ? escapeExperienceHtml(player.presence)
            : `Playing ${escapeExperienceHtml({{ experience.name|json_encode|raw }})}`;

        const identity = profileEnabled
            ? `<div class="fw-semibold"><a href="/profile/${encodeURIComponent(String(player.username || ''))}" class="text-decoration-none">${username}</a></div>`
            : `<div class="fw-semibold">${username}</div>`;

        const playingBadge = player.presence_state === 'playing'
            ? '<span class="badge bg-success me-1" aria-label="Currently playing">Playing</span>'
            : '';

        const message = messageEnabled &&
            window.currentUserId &&
            userId !== Number(window.currentUserId)
            ? `<a href="/chat?dm_user_id=${encodeURIComponent(String(userId))}" class="btn btn-sm btn-outline-secondary"><i class="fas fa-comment me-1" aria-hidden="true"></i>Message</a>`
            : '';

        const node = player.node !== null && player.node !== undefined
            ? `<span class="badge bg-secondary-subtle text-dark border">Node ${Number(player.node)}</span>`
            : '';

        return `<div class="list-group-item d-flex justify-content-between align-items-center gap-3">
    <div class="min-w-0">
        ${identity}
        <div class="text-muted small">
            ${playingBadge}
            ${presence}
        </div>
    </div>
    <div class="d-flex align-items-center gap-2 flex-shrink-0">
        ${message}
        ${node}
    </div>
</div>`;
    }).join('');
}

function formatExperienceActivityTime(value) {
    const date = new Date(value);

    if (Number.isNaN(date.getTime())) {
        return '';
    }

    return date.toLocaleString();
}

function renderExperienceActivity(activity = []) {
    const container = document.getElementById(
        'experience-recent-activity'
    );

    if (!container) return;

    if (!Array.isArray(activity) || activity.length === 0) {
        container.textContent = 'No recent activity yet.';
        return;
    }

    container.innerHTML = activity.slice(0, 5).map(entry => {
        const username = escapeHtml(
            entry.username || 'Unknown user'
        );

        const occurredAt = formatExperienceActivityTime(
            entry.occurred_at || ''
        );

        const time = occurredAt
            ? `<span class="text-nowrap">${escapeHtml(occurredAt)}</span>`
            : '';

        return `
            <div class="d-flex flex-wrap justify-content-between gap-2 py-1">
                <span>
                    <i class="fas fa-gamepad me-1" aria-hidden="true"></i>
                    <strong>${username}</strong> played
                </span>
                ${time}
            </div>
        `;
    }).join('');
}

function updateExperienceViewerActions(viewer = null) {
    const endButton = document.getElementById('experience-end-button');
    if (!endButton) return;

    const viewerActions = viewer && viewer.actions
        ? viewer.actions
        : {};

    const canEnd = viewerActions.end === true;

    endButton.classList.toggle('d-none', !canEnd);
    endButton.disabled = !canEnd;
}

function applyExperienceState(payload) {
    const state = payload.state || {};
    const viewer = payload.viewer || null;
    const actions = state.participant_actions || {};
    const recentActivity = payload.recent_activity || [];

    updateExperiencePlayerSummary(state);
    updateExperienceLiveState(state, viewer);
    updateExperienceViewerActions(viewer);
    renderExperienceParticipants(state, actions);
    renderExperienceActivity(recentActivity);
}

async function endExperienceParticipation() {
    const endButton = document.getElementById('experience-end-button');
    if (!endButton || endButton.disabled) {
        return;
    }

    if (!window.confirm(
        `End your active participation in ${EXPERIENCE_NAME}?`
    )) {
        return;
    }

    endButton.disabled = true;

    try {
        const csrfToken = document.querySelector(
            'meta[name="csrf-token"]'
        )?.content || '';

        const response = await fetch(
            `/api/experiences/${encodeURIComponent(EXPERIENCE_ID)}/end`,
            {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': csrfToken,
                },
            }
        );

        const result = await response.json();

        if (!response.ok || !result.success) {
            throw new Error(
                result.error || 'Unable to end active participation'
            );
        }

        const payload = await refreshExperienceState();
        applyExperienceState(payload);
    } catch (error) {
        window.alert(
            error instanceof Error
                ? error.message
                : 'Unable to end active participation'
        );

        try {
            const payload = await refreshExperienceState();
            applyExperienceState(payload);
        } catch (_) {
            endButton.disabled = false;
        }
    }
}

const experienceEndButton = document.getElementById(
    'experience-end-button'
);

if (experienceEndButton) {
    experienceEndButton.addEventListener(
        'click',
        endExperienceParticipation
    );
}

refreshExperienceState()
    .then(applyExperienceState)
    .catch(() => {});

function scheduleExperienceRefresh() {
    if (document.hidden) {
        return;
    }

    refreshExperienceState()
        .then(applyExperienceState)
        .catch(() => {});
}

setInterval(scheduleExperienceRefresh, 30000);
document.addEventListener('visibilitychange', scheduleExperienceRefresh);
</script>
{% endblock %}
