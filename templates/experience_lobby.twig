{% extends "base.twig" %}

{% block title %}{{ experience.name }} - {{ system_name }}{% endblock %}

{% block content %}
{# Slice 5A: consume the canonical ExperiencePresentation read model for
   identity, multiplayer, and cost. The route still supplies raw `experience`
   for aspects the presentation contract does not yet express (conversation
   capability, participant_actions, launch/return footer, JS identity). #}
{% set view = experience_presentation %}
<script>
    window.isExperiencePage = true;
</script>
<div class="container py-3" data-experience-lobby>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-8">

            <div class="card shadow-sm">
                <div class="card-body p-3 p-md-4">


                    {# Slice 5A: stack artwork above identity content on phones
                       (< 576px) so the title/metadata/description column gets the
                       full width; the approved side-by-side layout resumes at the
                       Bootstrap `sm` breakpoint and up. #}
                    <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-start gap-3 mb-3">
                        <img
                            src="{{ view.presentation.icon_url|default('/favicon.svg') }}"
                            alt="{{ view.name }}"
                            class="rounded flex-shrink-0"
                            style="width: 120px; height: 120px; object-fit: cover;"
                            onerror="this.src='/favicon.svg'"
                        >

                        <div class="flex-grow-1">
                            <h1 class="h3 mb-1">{{ view.name }}</h1>

                            {% if view.author or view.version %}
                                <div class="text-muted small mb-2">
                                    {% if view.version %}v{{ view.version }}{% endif %}
                                    {% if view.version and view.author %} · {% endif %}
                                    {% if view.author %}by {{ view.author }}{% endif %}
                                </div>
                            {% endif %}

                            <p class="text-muted small mb-2">
                                {{ view.description }}
                            </p>

                            <div class="d-flex flex-wrap gap-2">
                                {% if view.capabilities.multiplayer %}
                                    <span class="badge bg-secondary-subtle text-dark border">
                                        <i class="fas fa-users me-1" aria-hidden="true"></i>
                                        Multiplayer
                                    </span>
                                {% else %}
                                    <span class="badge bg-secondary-subtle text-dark border">
                                        <i class="fas fa-user me-1" aria-hidden="true"></i>
                                        Single Player
                                    </span>
                                {% endif %}

                                {# Slice 5A: no storefront-style "Free to play" emphasis. A
                                   concise cost indicator is shown only when the normalized
                                   credit cost is nonzero. #}
                                {% if view.cost.credits > 0 %}
                                    <span class="badge bg-secondary-subtle text-dark border">
                                        <i class="fas fa-coins me-1" aria-hidden="true"></i>
                                        {{ view.cost.credits }} credit{% if view.cost.credits != 1 %}s{% endif %}
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    {# Slice 5A: the live-player / roster / occupancy section is
                       multiplayer-only. Single-player Experiences never render it.
                       Backend session tracking is unaffected; only this presentation
                       is gated. A configured conversation panel is rendered
                       independently below regardless of this flag. #}
                    {% if view.capabilities.multiplayer %}
                    <div class="border rounded p-3 mb-4">
                        {# Slice "quiet the lobby": one occupancy expression only.
                           No standalone Live badge, no session-count telemetry,
                           no separate player-count sentence, no progress bar. The
                           30s refresh keeps #experience-occupancy-summary in sync
                           via the same canonical state/presentation contract. #}
                        <div class="mb-3">
                            <div class="fw-semibold">
                                <i class="fas fa-users me-1" aria-hidden="true"></i>
                                Live Players
                            </div>
                            <div id="experience-occupancy-summary" class="text-muted small">
                                {%- if view.capacity.at_capacity -%}
                                    Full
                                {%- else -%}
                                    {{ state.player_count }} online
                                {%- endif -%}
                                {%- if view.capacity.max_sessions and (view.capacity.at_capacity or state.player_count > 0) %} · {{ state.session_count }}/{{ view.capacity.max_sessions }}{% endif -%}
                            </div>
                        </div>

                        <div id="experience-participants"
                             class="{% if state.players|length > 0 %}list-group{% else %}text-muted small{% endif %}">
                            {% if state.players|length > 0 %}
                                {% for player in state.players %}
                                    {% include 'partials/experience_participant.twig' with {
                                        player: player,
                                        experience: experience,
                                        current_user: current_user,
                                        participant_actions: experience.participant_actions|default({})
                                    } %}
                                {% else %}
                                    No one is playing right now. Be the first one in.
                                {% endfor %}
                            {% else %}
                                No one is playing right now. Be the first one in.
                            {% endif %}
                        </div>
                    </div>
                    {% endif %}

                    <div class="border rounded p-3 mb-3">
                        <div class="fw-semibold mb-2">
                            <i class="fas fa-clock-rotate-left me-1" aria-hidden="true"></i>
                            Recent Activity
                        </div>

                        <div id="experience-recent-activity" class="small text-muted">
                            No recent activity yet.
                        </div>
                    </div>

                    {% if experience.capabilities.conversation %}
                        <div
                            id="experience-conversation"
                            class="border rounded p-3 mb-3"
                        >
                            <div class="fw-semibold mb-2">
                                <i class="fas fa-comments me-1" aria-hidden="true"></i>
                                Conversation
                            </div>

                            <div
                                id="experience-conversation-messages"
                                class="small text-muted mb-3"
                            >
                                Loading conversation…
                            </div>

                            <div class="d-flex gap-2 align-items-end">
                                <textarea
                                    id="experience-conversation-input"
                                    class="form-control"
                                    rows="2"
                                    maxlength="1000"
                                    placeholder="Join the conversation…"
                                    aria-label="Conversation message"
                                ></textarea>

                                <button
                                    id="experience-conversation-send"
                                    type="button"
                                    class="btn btn-primary flex-shrink-0"
                                >
                                    <i class="fas fa-paper-plane me-1" aria-hidden="true"></i>
                                    Send
                                </button>
                            </div>

                            <div
                                id="experience-conversation-error"
                                class="small text-danger mt-2 d-none"
                                role="alert"
                            ></div>
                        </div>
                    {% endif %}

                    {# Slice 5C: capacity/status semantics are owned by the canonical
                       ExperiencePresentation. The template only renders wording for the
                       semantic status code — it does not decide which status applies,
                       and it does not re-derive at_capacity.

                       Slice "quiet the lobby": the primary action (Enter / Return /
                       Full) is the whole statement for normal states. Only the
                       exceptional states carry a short explanatory line. The
                       live-refresh JS keeps an equivalent map keyed on the same
                       status code. #}
                    {% set launch_supported = view.actions.static_launchable %}
                    {% set viewer_participating = view.viewer.participating %}
                    {% set primary_action = view.actions.primary %}
                    {% set launch_blocked_by_capacity = view.viewer.blocked_by_capacity %}
                    {% set status_code = view.status.code %}
                    {% set credit_cost = view.cost.credits %}
                    {% set exceptional_status = status_code in ['at_capacity', 'planned', 'unavailable'] %}
                    {% set status_messages = {
                        'at_capacity': 'No open sessions right now.',
                        'planned': 'Not available here yet.',
                        'unavailable': 'Not available from this surface.'
                    } %}

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <a href="/games" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-1" aria-hidden="true"></i>
                            Back to Games
                        </a>

                        <div class="d-flex flex-wrap align-items-center justify-content-end gap-2">
                            <div class="text-end me-1">
                                {% if credit_cost > 0 %}
                                    <div class="d-flex align-items-center justify-content-end gap-2">
                                        <span class="badge bg-secondary-subtle text-dark border">
                                            {{ credit_cost }} credit{% if credit_cost != 1 %}s{% endif %}
                                        </span>
                                    </div>
                                {% endif %}

                                <div id="experience-availability-message"
                                     data-status-code="{{ status_code }}"
                                     class="text-muted small{% if credit_cost > 0 %} mt-1{% endif %}{% if not exceptional_status %} d-none{% endif %}">
                                    {{ exceptional_status ? (status_messages[status_code]|default('')) : '' }}
                                </div>
                            </div>

                            <button
                                id="experience-end-button"
                                type="button"
                                class="btn btn-outline-danger{% if not view.actions.end_participation %} d-none{% endif %}"
                                {% if not view.actions.end_participation %}disabled{% endif %}
                            >
                                <i class="fas fa-stop me-1" aria-hidden="true"></i>
                                End Participation
                            </button>

                            {% if launch_supported %}
                                <a id="experience-launch-button" href="{{ launch.url }}"
                                   class="btn btn-fidonet{% if launch_blocked_by_capacity %} disabled{% endif %}"
                                   data-viewer-participating="{{ viewer_participating ? 'true' : 'false' }}"
                                   {% if launch_blocked_by_capacity %}aria-disabled="true" tabindex="-1"{% endif %}>
                                    <span id="experience-launch-label">{% if launch_blocked_by_capacity %}Full{% elseif primary_action == 'return' %}Return{% else %}Enter{% endif %}</span>
                                </a>
                            {% endif %}
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>

</div>
{% endblock %}

{% block scripts %}
<script>
const EXPERIENCE_ID = {{ experience.id|json_encode|raw }};
const EXPERIENCE_NAME = {{ experience.name|json_encode|raw }};
const EXPERIENCE_CAPABILITIES =
    {{ experience.capabilities|default({})|json_encode|raw }};

let experienceConversationCursor = 0;
let experienceCurrentPlayers = [];
let experienceConversationMessages = [];

async function refreshExperienceState() {
    const response = await fetch(
        `/api/experiences/${encodeURIComponent(EXPERIENCE_ID)}/state`,
        { headers: { 'Accept': 'application/json' } }
    );

    if (!response.ok) {
        throw new Error(`Experience state request failed: ${response.status}`);
    }

    return response.json();
}


function updateExperiencePlayerSummary(state) {
    // Kept as the single place the conversation identity cache is refreshed
    // from live state. The occupancy line itself is rendered by
    // updateExperienceLiveState (it needs presentation.capacity too).
    experienceCurrentPlayers = Array.isArray(state.players)
        ? state.players
        : [];
}

function escapeExperienceHtml(value) {
    const div = document.createElement('div');
    div.textContent = String(value ?? '');
    return div.innerHTML;
}

// Short explanatory line for the exceptional states only. Normal states
// (available / participating) say everything through the primary action itself.
// Kept in sync with the Twig status_messages map above; the status code is
// decided server-side by ExperiencePresentation.
const EXPERIENCE_EXCEPTIONAL_STATUS = ['at_capacity', 'planned', 'unavailable'];
const EXPERIENCE_STATUS_MESSAGE = {
    at_capacity: 'No open sessions right now.',
    planned: 'Not available here yet.',
    unavailable: 'Not available from this surface.'
};

function experienceOccupancyText(state, presentation) {
    const online = Number(state.player_count || 0);
    const sessions = Number(state.session_count || 0);
    const capacity = (presentation && presentation.capacity) || {};
    const maxSessions = Number(capacity.max_sessions || 0);
    const atCapacity = !!capacity.at_capacity;

    let text = atCapacity ? 'Full' : `${online} online`;

    // Suppress the capacity ratio while the room is empty — the empty-state
    // copy below already invites the caller in.
    if (maxSessions > 0 && (atCapacity || online > 0)) {
        text += ` · ${sessions}/${maxSessions}`;
    }

    return text;
}

function updateExperienceLiveState(state, viewer = null, presentation = null) {
    const viewerParticipating = !!(viewer && viewer.participating);

    // Slice 5C: capacity/status policy comes from the server-composed
    // ExperiencePresentation, not from DOM inspection. This removes the
    // single-player drift where JS could not see max_sessions.
    const blockedByCapacity = !!(
        presentation
        && presentation.viewer
        && presentation.viewer.blocked_by_capacity
    );
    const launchSupported = !!(
        presentation
        && presentation.actions
        && presentation.actions.static_launchable
    );
    const statusCode =
        (presentation && presentation.status && presentation.status.code)
        || null;

    const occupancySummary = document.getElementById('experience-occupancy-summary');
    const availabilityMessage = document.getElementById('experience-availability-message');
    const launchButton = document.getElementById('experience-launch-button');

    // The one occupancy expression: "N online" / "N online · S/M" / "Full · M/M".
    if (occupancySummary) {
        occupancySummary.textContent = experienceOccupancyText(state, presentation);
    }

    // Only the exceptional states get a line; normal states stay silent because
    // the primary action already says Enter / Return.
    if (availabilityMessage) {
        const isExceptional = EXPERIENCE_EXCEPTIONAL_STATUS.includes(statusCode);
        availabilityMessage.textContent = isExceptional
            ? (EXPERIENCE_STATUS_MESSAGE[statusCode] || '')
            : '';
        availabilityMessage.classList.toggle('d-none', !isExceptional);

        if (statusCode) {
            availabilityMessage.dataset.statusCode = statusCode;
        }
    }

    if (launchButton) {
        const disabled = blockedByCapacity || !launchSupported;
        launchButton.classList.toggle('disabled', disabled);
        launchButton.setAttribute('aria-disabled', disabled ? 'true' : 'false');
        launchButton.tabIndex = disabled ? -1 : 0;

        const label = blockedByCapacity
            ? 'Full'
            : (viewerParticipating ? 'Return' : 'Enter');

        launchButton.setAttribute('aria-label', label);
        launchButton.dataset.viewerParticipating =
            viewerParticipating ? 'true' : 'false';

        const labelElement = document.getElementById('experience-launch-label');

        if (labelElement) {
            labelElement.textContent = label;
        }
    }
}

function renderExperienceParticipants(state, actions) {
    const container = document.getElementById('experience-participants');
    if (!container) return;

    const players = Array.isArray(state.players) ? state.players : [];
    const profileEnabled = !!(actions && actions.profile);
    const messageEnabled = !!(actions && actions.message);

    if (players.length === 0) {
        container.className = 'text-muted small';
        container.textContent = 'No one is playing right now. Be the first one in.';
        return;
    }

    container.className = 'list-group';

    container.innerHTML = players.map(player => {
        const userId = Number(player.user_id || 0);
        const username = escapeExperienceHtml(player.username);
        const presence = player.presence
            ? escapeExperienceHtml(player.presence)
            : `Playing ${escapeExperienceHtml({{ experience.name|json_encode|raw }})}`;

        const identity = profileEnabled
            ? `<div class="fw-semibold"><a href="/profile/${encodeURIComponent(String(player.username || ''))}" class="text-decoration-none">${username}</a></div>`
            : `<div class="fw-semibold">${username}</div>`;

        const message = messageEnabled &&
            window.currentUserId &&
            userId !== Number(window.currentUserId)
            ? `<a href="/chat?dm_user_id=${encodeURIComponent(String(userId))}" class="btn btn-sm btn-outline-secondary"><i class="fas fa-comment me-1" aria-hidden="true"></i>Message</a>`
            : '';

        return `<div class="list-group-item d-flex justify-content-between align-items-center gap-3">
    <div class="min-w-0">
        ${identity}
        <div class="text-muted small">
            ${presence}
        </div>
    </div>
    <div class="d-flex align-items-center gap-2 flex-shrink-0">
        ${message}
    </div>
</div>`;
    }).join('');
}

function getExperienceConversation() {
    const conversation = EXPERIENCE_CAPABILITIES.conversation || null;

    if (
        !conversation
        || conversation.type !== 'chat_room'
        || !Number.isInteger(Number(conversation.room_id))
        || Number(conversation.room_id) <= 0
    ) {
        return null;
    }

    return {
        type: 'chat_room',
        room_id: Number(conversation.room_id),
    };
}

function renderExperienceConversationIdentity(message) {
    const username = String(
        message.from_username || 'Unknown user'
    );
    const escapedUsername = escapeHtml(username);

    const userId = Number(message.from_user_id || 0);

    const player = experienceCurrentPlayers.find(candidate => {
        if (userId > 0 && Number(candidate.user_id) === userId) {
            return true;
        }

        return username !== 'Unknown user'
            && String(candidate.username || '').toLowerCase()
                === username.toLowerCase();
    });

    const identity = username === 'Unknown user'
        ? escapedUsername
        : `<a href="/profile/${encodeURIComponent(username)}"
              class="text-decoration-none">${escapedUsername}</a>`;

    const playing = player
        ? '<span class="badge bg-success ms-2">Playing</span>'
        : '';

    return `<strong>${identity}</strong>${playing}`;
}

function renderExperienceConversation(messages = []) {
    const container = document.getElementById(
        'experience-conversation-messages'
    );

    if (!container) return;

    if (!Array.isArray(messages) || messages.length === 0) {
        container.textContent = 'No conversation yet.';
        return;
    }

    container.innerHTML = messages.slice(-10).map(message => {
        const identity =
            renderExperienceConversationIdentity(message);

        const body = message.markup_html
            ? message.markup_html
            : escapeHtml(message.body || '');

        const occurredAt = formatExperienceActivityTime(
            message.created_at || ''
        );

        const time = occurredAt
            ? `<span class="text-muted text-nowrap">${escapeHtml(occurredAt)}</span>`
            : '';

        return `
            <div class="py-2 border-bottom"
                 data-experience-chat-message="${escapeHtml(String(message.id || ''))}">
                <div class="d-flex flex-wrap justify-content-between gap-2 mb-1">
                    <span>${identity}</span>
                    ${time}
                </div>
                <div>${body}</div>
            </div>
        `;
    }).join('');
}

function appendExperienceConversationMessage(message) {
    const container = document.getElementById(
        'experience-conversation-messages'
    );

    if (!container || !message) {
        return;
    }

    const existing = container.querySelectorAll(
        '[data-experience-chat-message]'
    );

    if (existing.length === 0) {
        container.innerHTML = '';
        container.classList.remove('text-muted');
    }

    const identity =
        renderExperienceConversationIdentity(message);

    const body = message.markup_html
        ? message.markup_html
        : escapeHtml(message.body || '');

    const occurredAt = formatExperienceActivityTime(
        message.created_at || ''
    );

    const time = occurredAt
        ? `<span class="text-muted text-nowrap">${escapeHtml(occurredAt)}</span>`
        : '';

    const row = document.createElement('div');
    row.className = 'py-2 border-bottom';
    row.dataset.experienceChatMessage = String(
        message.id || ''
    );

    row.innerHTML = `
        <div class="d-flex flex-wrap justify-content-between gap-2 mb-1">
            <span>${identity}</span>
            ${time}
        </div>
        <div>${body}</div>
    `;

    container.appendChild(row);

    while (
        container.querySelectorAll(
            '[data-experience-chat-message]'
        ).length > 10
    ) {
        container.querySelector(
            '[data-experience-chat-message]'
        )?.remove();
    }
}

async function pollExperienceConversation() {
    const conversation = getExperienceConversation();

    if (!conversation || document.hidden) {
        return;
    }

    const response = await fetch(
        `/api/chat/poll?since_id=${encodeURIComponent(experienceConversationCursor)}`
    );

    if (!response.ok) {
        return;
    }

    const payload = await response.json();
    const messages = Array.isArray(payload.messages)
        ? payload.messages
        : [];

    messages.forEach(message => {
        const id = Number(message.id || 0);

        if (id > experienceConversationCursor) {
            experienceConversationCursor = id;
        }

        if (
            message.type === 'room'
            && Number(message.room_id) === conversation.room_id
        ) {
            experienceConversationMessages.push(message);
            experienceConversationMessages =
                experienceConversationMessages.slice(-10);

            appendExperienceConversationMessage(message);
        }
    });
}

async function sendExperienceConversationMessage() {
    const conversation = getExperienceConversation();
    const input = document.getElementById(
        'experience-conversation-input'
    );
    const sendButton = document.getElementById(
        'experience-conversation-send'
    );
    const errorElement = document.getElementById(
        'experience-conversation-error'
    );

    if (!conversation || !input || !sendButton) {
        return;
    }

    const body = input.value.trim();

    if (!body) {
        return;
    }

    if (errorElement) {
        errorElement.textContent = '';
        errorElement.classList.add('d-none');
    }

    sendButton.disabled = true;
    input.disabled = true;

    try {
        const csrfToken = document.querySelector(
            'meta[name="csrf-token"]'
        )?.content || '';

        const response = await fetch('/api/chat/send', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': csrfToken,
            },
            body: JSON.stringify({
                room_id: conversation.room_id,
                body,
            }),
        });

        const result = await response.json();

        if (!response.ok || !result.success) {
            throw new Error(
                result.error || 'Unable to send message'
            );
        }

        input.value = '';

        if (result.local_message) {
            experienceConversationMessages.push(
                result.local_message
            );
            experienceConversationMessages =
                experienceConversationMessages.slice(-10);

            appendExperienceConversationMessage(
                result.local_message
            );
        }
    } catch (error) {
        if (errorElement) {
            errorElement.textContent =
                error instanceof Error
                    ? error.message
                    : 'Unable to send message';

            errorElement.classList.remove('d-none');
        }
    } finally {
        input.disabled = false;
        sendButton.disabled = false;
        input.focus();
    }
}

async function initializeExperienceConversation() {
    const conversation = getExperienceConversation();

    if (!conversation) {
        return;
    }

    const cursorResponse = await fetch('/api/chat/cursor');

    if (cursorResponse.ok) {
        const cursorPayload = await cursorResponse.json();
        experienceConversationCursor = Number(
            cursorPayload.max_id || 0
        );
    }

    await refreshExperienceConversation();
}

async function refreshExperienceConversation() {
    const conversation = getExperienceConversation();

    if (!conversation) {
        return;
    }

    const response = await fetch(
        `/api/chat/messages?room_id=${encodeURIComponent(conversation.room_id)}&limit=10`
    );

    const payload = await response.json();

    if (!response.ok) {
        throw new Error(
            payload.error || 'Unable to load conversation'
        );
    }

    const messages = payload.messages || [];

    experienceConversationMessages = messages.slice(-10);
    renderExperienceConversation(experienceConversationMessages);
}

function formatExperienceActivityTime(value, nowValue = new Date()) {
    const date = new Date(value);
    const now = nowValue instanceof Date
        ? nowValue
        : new Date(nowValue);

    if (Number.isNaN(date.getTime()) || Number.isNaN(now.getTime())) {
        return '';
    }

    const elapsedMs = now.getTime() - date.getTime();

    if (elapsedMs >= 0) {
        const elapsedMinutes = Math.floor(elapsedMs / 60000);

        if (elapsedMinutes < 1) {
            return 'just now';
        }

        if (elapsedMinutes < 60) {
            return `${elapsedMinutes} minute${elapsedMinutes === 1 ? '' : 's'} ago`;
        }

        const elapsedHours = Math.floor(elapsedMinutes / 60);

        if (elapsedHours < 24) {
            return `${elapsedHours} hour${elapsedHours === 1 ? '' : 's'} ago`;
        }
    }

    const localDayNumber = candidate => Date.UTC(
        candidate.getFullYear(),
        candidate.getMonth(),
        candidate.getDate()
    ) / 86400000;

    if (localDayNumber(now) - localDayNumber(date) === 1) {
        return 'yesterday';
    }

    const options = {
        month: 'short',
        day: 'numeric'
    };

    if (date.getFullYear() !== now.getFullYear()) {
        options.year = 'numeric';
    }

    return new Intl.DateTimeFormat(undefined, options).format(date);
}

function renderExperienceActivity(activity = []) {
    const container = document.getElementById(
        'experience-recent-activity'
    );

    if (!container) return;

    if (!Array.isArray(activity) || activity.length === 0) {
        container.textContent = 'No recent activity yet.';
        return;
    }

    container.innerHTML = activity.slice(0, 5).map(entry => {
        const username = escapeHtml(
            entry.username || 'Unknown user'
        );

        const occurredAt = formatExperienceActivityTime(
            entry.occurred_at || ''
        );

        const time = occurredAt
            ? `<span class="text-nowrap"> · ${escapeHtml(occurredAt)}</span>`
            : '';

        const activityLabel = entry.type === 'first_play'
            ? 'first recorded play'
            : 'played';

        return `
            <div class="d-flex flex-wrap gap-2 py-1">
                <span>
                    <i class="fas fa-gamepad me-1" aria-hidden="true"></i>
                    <strong>${username}</strong> ${activityLabel}${time}
                </span>
            </div>
        `;
    }).join('');
}

function updateExperienceViewerActions(viewer = null) {
    const endButton = document.getElementById('experience-end-button');
    if (!endButton) return;

    const viewerActions = viewer && viewer.actions
        ? viewer.actions
        : {};

    const canEnd = viewerActions.end === true;

    endButton.classList.toggle('d-none', !canEnd);
    endButton.disabled = !canEnd;
}

function applyExperienceState(payload) {
    const state = payload.state || {};
    const viewer = payload.viewer || null;
    const presentation = payload.presentation || null;
    const actions = state.participant_actions || {};
    const recentActivity = payload.recent_activity || [];

    updateExperiencePlayerSummary(state);
    updateExperienceLiveState(state, viewer, presentation);
    updateExperienceViewerActions(viewer);
    renderExperienceParticipants(state, actions);
    renderExperienceActivity(recentActivity);
    renderExperienceConversation(experienceConversationMessages);
}

async function endExperienceParticipation() {
    const endButton = document.getElementById('experience-end-button');
    if (!endButton || endButton.disabled) {
        return;
    }

    if (!window.confirm(
        `End your active participation in ${EXPERIENCE_NAME}?`
    )) {
        return;
    }

    endButton.disabled = true;

    try {
        const csrfToken = document.querySelector(
            'meta[name="csrf-token"]'
        )?.content || '';

        const response = await fetch(
            `/api/experiences/${encodeURIComponent(EXPERIENCE_ID)}/end`,
            {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': csrfToken,
                },
            }
        );

        const result = await response.json();

        if (!response.ok || !result.success) {
            throw new Error(
                result.error || 'Unable to end active participation'
            );
        }

        const payload = await refreshExperienceState();
        applyExperienceState(payload);
    } catch (error) {
        window.alert(
            error instanceof Error
                ? error.message
                : 'Unable to end active participation'
        );

        try {
            const payload = await refreshExperienceState();
            applyExperienceState(payload);
        } catch (_) {
            endButton.disabled = false;
        }
    }
}

const experienceConversationInput = document.getElementById(
    'experience-conversation-input'
);
const experienceConversationSend = document.getElementById(
    'experience-conversation-send'
);

if (experienceConversationSend) {
    experienceConversationSend.addEventListener(
        'click',
        sendExperienceConversationMessage
    );
}

if (experienceConversationInput) {
    experienceConversationInput.addEventListener(
        'keydown',
        (event) => {
            if (
                event.key === 'Enter'
                && (event.ctrlKey || event.metaKey)
            ) {
                event.preventDefault();
                sendExperienceConversationMessage();
            }
        }
    );
}

const experienceEndButton = document.getElementById(
    'experience-end-button'
);

if (experienceEndButton) {
    experienceEndButton.addEventListener(
        'click',
        endExperienceParticipation
    );
}

refreshExperienceState()
    .then(applyExperienceState)
    .catch(() => {});

initializeExperienceConversation()
    .catch(() => {
        const container = document.getElementById(
            'experience-conversation-messages'
        );

        if (container) {
            container.textContent =
                'Conversation is temporarily unavailable.';
        }
    });

function scheduleExperienceRefresh() {
    if (document.hidden) {
        return;
    }

    refreshExperienceState()
        .then(applyExperienceState)
        .catch(() => {});
}

setInterval(scheduleExperienceRefresh, 30000);
setInterval(pollExperienceConversation, 5000);

document.addEventListener('visibilitychange', () => {
    scheduleExperienceRefresh();
    pollExperienceConversation();
});
</script>
{% endblock %}
