{% extends "base.twig" %}

{% block title %}{{ t('ui.webdoors.page_title', {}, locale, ['common']) }} - {{ system_name }}{% endblock %}

{% block head %}
<link href="/css/experiences.css" rel="stylesheet">
{% endblock %}

{% block content %}
<div class="container experiences-library py-3 py-md-4">
    <header class="experiences-library-header mb-4">
        <div class="experiences-eyebrow">{{ system_name }} // {{ t('ui.webdoors.heading', {}, locale, ['common']) }}</div>
        <h1 class="h2 mb-1"><i class="fas fa-compass me-2" aria-hidden="true"></i>{{ t('ui.webdoors.heading', {}, locale, ['common']) }}</h1>
        <p class="text-muted mb-0">{{ t('ui.webdoors.description', {}, locale, ['common']) }}</p>
    </header>

    {# Slice 5E: "Around the Crossroads" — one quiet line answering "is anyone
       around?" from the server-rendered ExperienceState snapshot. Counts only;
       player names live in Live Now / Continue Playing. #}
    {% set around_players = around_active_players|default(0) %}
    {% set around_experiences = around_active_experiences|default(0) %}
    {% if show_global_presence_summary is not defined or show_global_presence_summary %}
    <p class="experiences-around{% if around_players > 0 %} experiences-around--active{% endif %} mb-4">
        {%- if around_players > 0 -%}
            {%- if around_players == 1 and around_experiences == 1 -%}
                {{ t('ui.webdoors.around_active_1p_1e', {}, locale, ['common']) }}
            {%- elseif around_players == 1 -%}
                {{ t('ui.webdoors.around_active_1p', {'experiences': around_experiences}, locale, ['common']) }}
            {%- elseif around_experiences == 1 -%}
                {{ t('ui.webdoors.around_active_1e', {'players': around_players}, locale, ['common']) }}
            {%- else -%}
                {{ t('ui.webdoors.around_active', {'players': around_players, 'experiences': around_experiences}, locale, ['common']) }}
            {%- endif -%}
        {%- else -%}
            {{ t('ui.webdoors.around_quiet', {}, locale, ['common']) }}
        {%- endif -%}
    </p>
    {% endif %}

    {% if continue_playing|default([])|length > 0 %}
    <section class="experience-section mb-4" aria-labelledby="continue-playing-title">
        <div class="experience-section-heading">
            <div>
                <h2 id="continue-playing-title" class="h4 mb-1">{{ t('ui.webdoors.continue_playing', {}, locale, ['common']) }}</h2>
                <p class="text-muted small mb-0">{{ t('ui.webdoors.continue_playing_description', {}, locale, ['common']) }}</p>
            </div>
        </div>
        <div class="d-grid gap-2 mt-3">
            {% for game in continue_playing %}
                {% set view = game.experience_presentation %}
                <article class="card experience-resume-card mb-0">
                    <div class="card-body d-flex flex-column flex-md-row align-items-md-center gap-3 py-3">
                        <img class="experience-resume-icon" src="{{ view.presentation.icon_url|default('/favicon.svg') }}" alt="" onerror="this.src='/favicon.svg'">
                        <div class="flex-grow-1 min-w-0">
                            <h3 class="h5 mb-1">{{ view.name }}</h3>
                            <div class="text-muted small">
                                {{ t('ui.webdoors.participating_now', {}, locale, ['common']) }}
                                {% if view.runtime.player_count > 0 %} · {{ t('ui.webdoors.players_online', {'count': view.runtime.player_count}, locale, ['common']) }}{% endif %}
                            </div>
                            {% include 'partials/experience_hub_roster.twig' with {
                                players: experience_states[game.id].players|default([]),
                                experience_id: view.id,
                                exclude_user_id: (current_user.user_id ?? current_user.id ?? 0),
                                prefix: t('ui.webdoors.playing_with', {}, locale, ['common'])
                            } %}
                        </div>
                        <div class="d-flex gap-2 flex-shrink-0">
                            <a href="/experiences/{{ view.id }}" class="btn btn-outline-secondary btn-sm">{{ t('ui.webdoors.details', {}, locale, ['common']) }}</a>
                            {% if view.actions.return and game.launch %}
                            <a href="/experiences/{{ view.id }}" class="btn btn-fidonet btn-sm">{{ t('ui.webdoors.return', {}, locale, ['common']) }}</a>
                            {% endif %}
                        </div>
                    </div>
                </article>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {% if live_experiences|default([])|length > 0 %}
    <section class="experience-section mb-4" aria-labelledby="live-now-title">
        <div class="experience-section-heading">
            <div>
                <h2 id="live-now-title" class="h4 mb-1">{{ t('ui.webdoors.live_now', {}, locale, ['common']) }}</h2>
                <p class="text-muted small mb-0">{{ t('ui.webdoors.live_now_description', {}, locale, ['common']) }}</p>
            </div>
        </div>
        <div class="row row-cols-1 row-cols-lg-2 g-3 mt-0">
            {% for game in live_experiences %}
                {% set view = game.experience_presentation %}
                <div class="col">
                    <article class="card experience-live-card h-100 mb-0">
                        <div class="card-body d-flex align-items-center gap-3 py-3">
                            <span class="experience-live-dot" aria-hidden="true"></span>
                            <div class="flex-grow-1 min-w-0">
                                <h3 class="h6 mb-1"><a href="/experiences/{{ view.id }}" class="text-decoration-none">{{ view.name }}</a></h3>
                                <div class="text-muted small">{{ t('ui.webdoors.players_online', {'count': view.runtime.player_count}, locale, ['common']) }}{% if view.capacity.max_sessions %} · {{ view.runtime.session_count }}/{{ view.capacity.max_sessions }}{% endif %}</div>
                                {% include 'partials/experience_hub_roster.twig' with {
                                    players: experience_states[game.id].players|default([]),
                                    experience_id: view.id
                                } %}
                            </div>
                            <span class="experience-state-label experience-state-live">{{ t('ui.webdoors.live', {}, locale, ['common']) }}</span>
                        </div>
                    </article>
                </div>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    <section class="experience-section mb-5" aria-labelledby="all-experiences-title">
        <div class="experience-section-heading">
            <div>
                <h2 id="all-experiences-title" class="h4 mb-1">{{ t('ui.webdoors.all_experiences', {}, locale, ['common']) }}</h2>
                <p class="text-muted small mb-0">{{ t('ui.webdoors.all_experiences_description', {}, locale, ['common']) }}</p>
            </div>
            <span class="experience-count" aria-live="polite" aria-atomic="true">{{ games|length }}</span>
        </div>

        {% if games|length > 0 %}
        <div class="experience-filter-toolbar mt-3" data-experience-filter-controls role="group" aria-label="{{ t('ui.webdoors.filter_controls', {}, locale, ['common']) }}">
            <div class="experience-filter-search">
                <label for="experience-filter-search" class="visually-hidden">{{ t('ui.webdoors.filter_search_label', {}, locale, ['common']) }}</label>
                <input type="search" class="form-control form-control-sm" id="experience-filter-search" placeholder="{{ t('ui.webdoors.filter_search_placeholder', {}, locale, ['common']) }}" autocomplete="off">
            </div>
            <div class="experience-filter-toggles">
                <div class="form-check form-check-inline experience-filter-toggle">
                    <input class="form-check-input" type="checkbox" id="experience-filter-live" data-experience-filter="live">
                    <label class="form-check-label" for="experience-filter-live">{{ t('ui.webdoors.filter_live', {}, locale, ['common']) }}</label>
                </div>
                <div class="form-check form-check-inline experience-filter-toggle">
                    <input class="form-check-input" type="checkbox" id="experience-filter-multiplayer" data-experience-filter="multiplayer">
                    <label class="form-check-label" for="experience-filter-multiplayer">{{ t('ui.webdoors.filter_multiplayer', {}, locale, ['common']) }}</label>
                </div>
                <div class="form-check form-check-inline experience-filter-toggle">
                    <input class="form-check-input" type="checkbox" id="experience-filter-web" data-experience-filter="web">
                    <label class="form-check-label" for="experience-filter-web">{{ t('ui.webdoors.filter_web_available', {}, locale, ['common']) }}</label>
                </div>
                <div class="form-check form-check-inline experience-filter-toggle">
                    <input class="form-check-input" type="checkbox" id="experience-filter-telnet" data-experience-filter="telnet">
                    <label class="form-check-label" for="experience-filter-telnet">{{ t('ui.webdoors.filter_telnet_available', {}, locale, ['common']) }}</label>
                </div>
            </div>
            <button type="button" class="btn btn-outline-secondary btn-sm experience-filter-reset" data-experience-filter-reset>{{ t('ui.webdoors.clear_filters', {}, locale, ['common']) }}</button>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-2 mt-0 experience-library-grid" data-experience-filter-root>
            {% for game in games %}
                {% include 'partials/experience_library_card.twig' with {game: game} %}
            {% endfor %}
        </div>
        <div class="alert alert-info mt-3 mb-0 d-none experience-filter-empty" data-experience-filter-empty aria-live="polite">
            <i class="fas fa-info-circle me-1" aria-hidden="true"></i>{{ t('ui.webdoors.no_filter_matches', {}, locale, ['common']) }}
            <button type="button" class="btn btn-outline-secondary btn-sm ms-2" data-experience-filter-reset>{{ t('ui.webdoors.clear_filters', {}, locale, ['common']) }}</button>
        </div>
        {% else %}
        <div class="alert alert-info mt-3 mb-0">
            <i class="fas fa-info-circle me-1" aria-hidden="true"></i>{{ t('ui.webdoors.no_games_available', {}, locale, ['common']) }}
        </div>
        {% endif %}
    </section>

    <section class="experience-section" aria-labelledby="community-scoreboard-title">
        <div class="card experience-scoreboard mb-0">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h2 id="community-scoreboard-title" class="h5 mb-0"><i class="fas fa-trophy text-warning me-2" aria-hidden="true"></i>{{ t('ui.webdoors.community_scoreboard', {}, locale, ['common']) }}</h2>
                    <small class="text-muted">{{ t('ui.webdoors.community_scoreboard_description', {}, locale, ['common']) }}</small>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <div class="btn-group btn-group-sm" role="group" aria-label="{{ t('ui.webdoors.leaderboard_month_navigation', {}, locale, ['common']) }}">
                        <a class="btn btn-outline-secondary btn-sm" href="/games?month_offset={{ leaderboard_month_offset + 1 }}{% if scoreboard_expanded %}&amp;scoreboard=full{% endif %}" title="{{ t('ui.webdoors.previous_month', {}, locale, ['common']) }}" aria-label="{{ t('ui.webdoors.previous_month', {}, locale, ['common']) }}"><i class="fas fa-chevron-left" aria-hidden="true"></i></a>
                        {% if leaderboard_month_offset > 0 %}
                        <a class="btn btn-outline-secondary btn-sm" href="/games?month_offset={{ leaderboard_month_offset - 1 }}{% if scoreboard_expanded %}&amp;scoreboard=full{% endif %}" title="{{ t('ui.webdoors.next_month', {}, locale, ['common']) }}" aria-label="{{ t('ui.webdoors.next_month', {}, locale, ['common']) }}"><i class="fas fa-chevron-right" aria-hidden="true"></i></a>
                        {% else %}
                        <button class="btn btn-outline-secondary btn-sm" type="button" disabled title="{{ t('ui.webdoors.current_month', {}, locale, ['common']) }}" aria-label="{{ t('ui.webdoors.current_month', {}, locale, ['common']) }}"><i class="fas fa-chevron-right" aria-hidden="true"></i></button>
                        {% endif %}
                    </div>
                    <small class="text-muted text-nowrap">{{ leaderboard_month_label }}</small>
                </div>
            </div>
            <div class="card-body p-0">
                {% if leaderboard|length == 0 %}
                <div class="text-center text-muted py-4">{{ t('ui.webdoors.no_scores_for_month', {'month': leaderboard_month_label}, locale, ['common']) }}</div>
                {% else %}
                <div class="table-responsive">
                    <table class="table table-sm mb-0 align-middle experience-scoreboard-table">
                        <thead><tr><th>{{ t('ui.webdoors.rank', {}, locale, ['common']) }}</th><th>{{ t('ui.webdoors.player', {}, locale, ['common']) }}</th><th>{{ t('ui.webdoors.game', {}, locale, ['common']) }}</th><th>{{ t('ui.webdoors.board', {}, locale, ['common']) }}</th><th class="text-end">{{ t('ui.webdoors.score', {}, locale, ['common']) }}</th><th>{{ t('ui.webdoors.date', {}, locale, ['common']) }}</th></tr></thead>
                        <tbody>
                        {% for entry in leaderboard %}
                        <tr><td data-label="{{ t('ui.webdoors.rank', {}, locale, ['common']) }}" class="text-muted">#{{ entry.rank }}</td><td data-label="{{ t('ui.webdoors.player', {}, locale, ['common']) }}">{{ entry.display_name }}</td><td data-label="{{ t('ui.webdoors.game', {}, locale, ['common']) }}">{% if entry.game_launch %}<a href="/experiences/{{ entry.game_id }}" class="leaderboard-link">{{ entry.game_name }}</a>{% else %}{{ entry.game_name }}{% endif %}</td><td data-label="{{ t('ui.webdoors.board', {}, locale, ['common']) }}"><span class="experience-technical-label">{{ entry.board }}</span></td><td data-label="{{ t('ui.webdoors.score', {}, locale, ['common']) }}" class="text-end">{{ entry.score }}</td><td data-label="{{ t('ui.webdoors.date', {}, locale, ['common']) }}" class="text-muted">{{ entry.date }}</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% endif %}
            </div>
            <div class="card-footer text-end">
                {% if scoreboard_expanded %}
                <a href="/games?month_offset={{ leaderboard_month_offset }}" class="btn btn-outline-secondary btn-sm">{{ t('ui.webdoors.show_compact_scoreboard', {}, locale, ['common']) }}</a>
                {% else %}
                <a href="/games?month_offset={{ leaderboard_month_offset }}&amp;scoreboard=full" class="btn btn-outline-secondary btn-sm">{{ t('ui.webdoors.view_full_scoreboard', {}, locale, ['common']) }}</a>
                {% endif %}
            </div>
        </div>
    </section>
</div>

<script>
(function () {
    const filterRoot = document.querySelector('[data-experience-filter-root]');
    const filterItems = filterRoot
        ? Array.from(filterRoot.querySelectorAll('[data-experience-filter-item]'))
        : [];
    const filterSearch = document.getElementById('experience-filter-search');
    const filterInputs = Array.from(document.querySelectorAll('[data-experience-filter]'));
    const filterResetButtons = Array.from(document.querySelectorAll('[data-experience-filter-reset]'));
    const filterEmpty = document.querySelector('[data-experience-filter-empty]');
    const filterCount = document.querySelector('#all-experiences-title')
        ?.closest('.experience-section-heading')
        ?.querySelector('.experience-count');
    const presenceElements = document.querySelectorAll('.experience-presence');
    const playersOnlineFallback = '{{ t('ui.webdoors.players_online', {'count': '{count}'}, locale, ['common']) | escape('js') }}';
    const fullCapacityFallback = '{{ t('ui.webdoors.full_capacity', {}, locale, ['common']) | escape('js') }}';

    function normalizeSearch(value) {
        return String(value || '')
            .toLocaleLowerCase()
            .trim()
            .replace(/\s+/g, ' ');
    }

    function filterIsActive(name) {
        return Boolean(document.querySelector(
            '[data-experience-filter="' + name + '"]:checked'
        ));
    }

    function applyExperienceFilters() {
        if (!filterRoot) {
            return;
        }

        const searchTerms = normalizeSearch(filterSearch?.value).split(' ').filter(Boolean);
        const liveOnly = filterIsActive('live');
        const multiplayerOnly = filterIsActive('multiplayer');
        const webOnly = filterIsActive('web');
        const telnetOnly = filterIsActive('telnet');
        let visibleCount = 0;

        filterItems.forEach(function (item) {
            const searchableText = normalizeSearch(
                item.dataset.filterName + ' ' + item.dataset.filterDescription
            );
            const matchesSearch = searchTerms.every(function (term) {
                return searchableText.includes(term);
            });
            const matchesLive = !liveOnly || Number(item.dataset.filterPlayerCount || 0) > 0;
            const matchesMultiplayer = !multiplayerOnly || item.dataset.filterMultiplayer === '1';
            const matchesWeb = !webOnly || item.dataset.filterWeb === 'full';
            const matchesTelnet = !telnetOnly || item.dataset.filterTelnet === 'full';
            const visible = matchesSearch
                && matchesLive
                && matchesMultiplayer
                && matchesWeb
                && matchesTelnet;

            item.hidden = !visible;
            if (visible) {
                visibleCount += 1;
            }
        });

        if (filterCount) {
            filterCount.textContent = String(visibleCount);
        }
        if (filterEmpty) {
            filterEmpty.classList.toggle('d-none', visibleCount !== 0);
        }
    }

    function resetExperienceFilters() {
        if (filterSearch) {
            filterSearch.value = '';
        }
        filterInputs.forEach(function (input) {
            input.checked = false;
        });
        applyExperienceFilters();
        filterSearch?.focus();
    }

    filterSearch?.addEventListener('input', applyExperienceFilters);
    filterInputs.forEach(function (input) {
        input.addEventListener('change', applyExperienceFilters);
    });
    filterResetButtons.forEach(function (button) {
        button.addEventListener('click', resetExperienceFilters);
    });

    function updateFilterOccupancy(element, playerCount) {
        const filterItem = element.closest('[data-experience-filter-item]');
        if (!filterItem) {
            return;
        }

        filterItem.dataset.filterPlayerCount = String(playerCount);
        applyExperienceFilters();
    }

    function presenceT(params) {
        if (typeof window.t === 'function') {
            return window.t(
                'ui.webdoors.players_online',
                params,
                playersOnlineFallback
            );
        }

        return playersOnlineFallback.replace(
            /\{([^}]+)\}/g,
            (_, key) => params[key] ?? ''
        );
    }

    function fullCapacityT() {
        if (typeof window.t === 'function') {
            return window.t('ui.webdoors.full_capacity', {}, fullCapacityFallback);
        }

        return fullCapacityFallback;
    }

    function setPresenceVisible(element, visible) {
        element.classList.toggle('d-none', !visible);
    }

    function renderPresence(element, payload) {
        const state = payload.state || {};
        const presentation = payload.presentation || {};
        const playerCount = Number(state.player_count || 0);
        const label = element.querySelector('span');

        if (!label) {
            return;
        }

        if (playerCount === 0) {
            label.textContent = '';
            setPresenceVisible(element, false);
            updateFilterOccupancy(element, 0);
            return;
        }

        const sessionCount = Number(state.session_count || 0);
        // Slice 5D: consume the canonical 5C presentation capacity. The old
        // per-card `state` payload never carried a nested experience/capacity
        // object, so this suffix was silently lost after the first refresh.
        const maxSessions = Number(
            (presentation.capacity && presentation.capacity.max_sessions) || 0
        );
        // Slice 5F: an at-capacity Experience reads "Full · N/M", not "N online",
        // and its dot loses the green "come on in" colour. Keep this in sync on
        // every refresh so the initial server render is not overwritten.
        const atCapacity = !!(
            presentation.capacity && presentation.capacity.at_capacity
        );

        let presenceText = atCapacity
            ? fullCapacityT()
            : presenceT({ count: playerCount });
        if (maxSessions > 0) {
            presenceText += ' · ' + sessionCount + '/' + maxSessions;
        }

        element.classList.toggle('experience-presence--full', atCapacity);
        const dot = element.querySelector('i.fa-circle');
        if (dot) {
            dot.classList.toggle('text-success', !atCapacity);
            dot.classList.toggle('experience-presence-dot--full', atCapacity);
        }

        label.textContent = presenceText;
        setPresenceVisible(element, true);
        updateFilterOccupancy(element, playerCount);
    }

    function renderUnavailable(element) {
        const label = element.querySelector('span');

        if (label) {
            label.textContent = '';
        }

        setPresenceVisible(element, false);
    }

    async function refreshPresence(element) {
        const experienceId = element.dataset.experienceId;

        if (!experienceId) {
            return;
        }

        try {
            const response = await fetch(
                '/api/experiences/' +
                encodeURIComponent(experienceId) +
                '/state',
                {
                    headers: {
                        'Accept': 'application/json'
                    }
                }
            );

            if (!response.ok) {
                renderUnavailable(element);
                return;
            }

            const payload = await response.json();

            if (!payload.success || !payload.state) {
                renderUnavailable(element);
                return;
            }

            renderPresence(element, payload);
        } catch (error) {
            renderUnavailable(element);
        }
    }

    function refreshAllPresence() {
        presenceElements.forEach(function (element) {
            refreshPresence(element);
        });
    }

    applyExperienceFilters();
    if (presenceElements.length) {
        refreshAllPresence();
        window.setInterval(refreshAllPresence, 15000);
    }
})();
</script>
{% endblock %}
