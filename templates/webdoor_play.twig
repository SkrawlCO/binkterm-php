{% extends "base.twig" %}

{% block title %}{{ game.name }} - {{ t('ui.webdoor_play.page_title_suffix', {}, locale, ['common']) }} - {{ system_name }}{% endblock %}

{% block content %}
<div class="container-fluid mt-2">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex align-items-center">
            <a href="{{ return_url|default('/games') }}" class="btn btn-outline-secondary btn-sm me-3">
                <i class="fas fa-arrow-left"></i> {{ t('ui.webdoor_play.back_to_crossroads', {}, locale, ['common']) }}
            </a>
            <h4 class="mb-0"><i class="fas fa-gamepad"></i> {{ game.name }}</h4>
        </div>
        <div>
            <button id="fullscreen-btn" class="btn btn-outline-primary btn-sm" title="{{ t('ui.webdoor_play.fullscreen', {}, locale, ['common']) }}">
                <i class="fas fa-expand"></i>
            </button>
        </div>
    </div>

    <div class="game-container">
        {# Crossroads-owned escape affordance. Only rendered while the
           .game-container element itself is fullscreen (the case the wrapper's
           own fullscreen button creates for every WebDoor, including Chessmata
           and OpenGlad) -- the normal top bar is a sibling and the browser does
           not paint it during fullscreen. Idle it is nearly transparent and
           only its two hitboxes are clickable, so it does not obscure or
           intercept gameplay. It is not in the tab order or layout when hidden. #}
        <div class="webdoor-fs-escape" id="webdoor-fs-escape" role="group"
             aria-label="{{ t('ui.webdoor_play.fs_controls_label', {}, locale, ['common']) }}" aria-hidden="true">
            <a href="{{ return_url|default('/games') }}" class="webdoor-fs-btn" id="webdoor-fs-leave" tabindex="-1">
                <i class="fas fa-arrow-left"></i> {{ t('ui.webdoor_play.back_to_crossroads', {}, locale, ['common']) }}
            </a>
            <button type="button" class="webdoor-fs-btn" id="webdoor-fs-exit" tabindex="-1">
                <i class="fas fa-compress"></i> {{ t('ui.webdoor_play.exit_fullscreen', {}, locale, ['common']) }}
            </button>
        </div>
        <iframe id="game-frame"
                src="{{ game_url }}"
                class="game-frame"
                allowfullscreen
                allow="autoplay; fullscreen">
        </iframe>
    </div>
</div>

<style>
.game-container {
    position: relative;
    width: 100%;
    height: calc(100vh - 150px);
    min-height: 500px;
    background: #000;
    border-radius: 8px;
    overflow: hidden;
}

.game-frame {
    width: 100%;
    height: 100%;
    border: none;
}

/* Fullscreen styles */
.game-container:fullscreen {
    height: 100vh;
}

.game-container:fullscreen .game-frame {
    height: 100vh;
}

/* Crossroads-owned fullscreen escape affordance (hidden unless the
   .game-container element is the fullscreen element). */
.webdoor-fs-escape {
    display: none;
}
.game-container:fullscreen .webdoor-fs-escape,
.game-container:-webkit-full-screen .webdoor-fs-escape {
    display: flex;
    gap: .4rem;
    position: absolute;
    top: .5rem;
    right: .5rem;
    z-index: 20;
    pointer-events: none;      /* only the buttons catch clicks */
    opacity: .22;
    transition: opacity .15s ease;
}
.game-container:fullscreen .webdoor-fs-escape:hover,
.game-container:fullscreen .webdoor-fs-escape:focus-within {
    opacity: 1;
}
.webdoor-fs-btn {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    padding: .3rem .6rem;
    font-size: .8rem;
    line-height: 1;
    color: #fff;
    background: rgba(15, 17, 21, .82);
    border: 1px solid rgba(255, 255, 255, .35);
    border-radius: 999px;
    text-decoration: none;
    cursor: pointer;
}
.webdoor-fs-btn:hover,
.webdoor-fs-btn:focus-visible {
    background: rgba(15, 17, 21, .95);
    color: #fff;
    outline: 2px solid rgba(255, 255, 255, .6);
    outline-offset: 1px;
}
</style>

<script>
document.getElementById('fullscreen-btn').addEventListener('click', function() {
    const container = document.querySelector('.game-container');
    if (container.requestFullscreen) {
        container.requestFullscreen();
    } else if (container.webkitRequestFullscreen) {
        container.webkitRequestFullscreen();
    } else if (container.msRequestFullscreen) {
        container.msRequestFullscreen();
    }
});

// Handle escape key to exit game
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && document.fullscreenElement) {
        document.exitFullscreen();
    }
});

// Crossroads-owned fullscreen escape affordance. The "Back to Crossroads" link
// navigates (which auto-exits fullscreen and fires the End Session beacon
// below); the "Exit Fullscreen" button just drops out of fullscreen so the
// normal wrapper controls return. The affordance is only reachable/keyboard-
// focusable while the .game-container element is the fullscreen element.
(function () {
    var container = document.querySelector('.game-container');
    var escape = document.getElementById('webdoor-fs-escape');
    var exitBtn = document.getElementById('webdoor-fs-exit');
    if (!container || !escape || !exitBtn) {
        return;
    }

    function fsElement() {
        return document.fullscreenElement || document.webkitFullscreenElement || null;
    }

    exitBtn.addEventListener('click', function () {
        if (document.exitFullscreen) {
            document.exitFullscreen();
        } else if (document.webkitExitFullscreen) {
            document.webkitExitFullscreen();
        }
    });

    function syncEscape() {
        var active = fsElement() === container;
        escape.setAttribute('aria-hidden', active ? 'false' : 'true');
        escape.querySelectorAll('.webdoor-fs-btn').forEach(function (el) {
            el.setAttribute('tabindex', active ? '0' : '-1');
        });
    }

    document.addEventListener('fullscreenchange', syncEscape);
    document.addEventListener('webkitfullscreenchange', syncEscape);
    syncEscape();
})();

// Leaving the WebDoor page ends this game's active participation, so Crossroads
// presence (Live Now, rosters, "Your Places") reflects that the player has left
// instead of showing them for up to an hour. Mirrors the jsdos host page's
// beforeunload beacon. Managed DOS/native doors deliberately do NOT do this —
// they have a live bridge session to reconnect to; a WebDoor does not, and its
// progress is saved per game+slot, so re-entering resumes from the last save.
(function () {
    var WEBDOOR_GAME_ID = {{ game_id|default('')|json_encode|raw }};
    var ended = false;

    window.addEventListener('beforeunload', function () {
        if (ended || !WEBDOOR_GAME_ID || !navigator.sendBeacon) {
            return;
        }
        ended = true;
        navigator.sendBeacon(
            '/api/webdoor/session/end?game_id=' + encodeURIComponent(WEBDOOR_GAME_ID)
        );
    });
})();

// Refocus input inside the iframe when the WebDoor requests it (e.g. Tab completion).
// Same-origin iframes allow direct DOM access, so we can focus the element directly.
window.addEventListener('message', function(e) {
    if (e.data && e.data.type === 'mrc:keepFocus') {
        const frame = document.getElementById('game-frame');
        if (frame && frame.contentDocument) {
            const input = frame.contentDocument.getElementById('message-input');
            if (input) {
                input.focus();
            }
        }
    }
});
</script>
{% endblock %}
