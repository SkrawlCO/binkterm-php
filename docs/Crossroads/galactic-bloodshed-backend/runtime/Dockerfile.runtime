# syntax=docker/dockerfile:1
#
# Galactic Bloodshed production RUNTIME image (server + admin/provisioner
# binaries). Multi-stage: heavy build stage (the pinned builder from
# ../build/) produces the binaries; the runtime stage is a small,
# non-toolchain image containing only what actually needs to run. Two
# targets are produced from this one file (build with --target):
#
#   gb-server  - just the GB daemon (what the always-on service runs)
#   gb-admin   - makeuniv/enrol/racegen + the narrow provisioning daemon
#                (gb_provisiond.py -- see ../provisioning/), against the SAME
#                persistent volume as gb-server. binkterm-app's NativeDoor
#                launcher never runs enrol itself or touches this volume --
#                it only speaks gb_provisiond.py's Unix-socket protocol. See
#                ../README.md "Production service architecture" and the
#                parent slice report "Narrow provisioning service" for why
#                (rejected: Docker socket access from binkterm-app).
#                Default CMD runs the daemon (the image's primary role);
#                makeuniv/racegen remain available via `--entrypoint` for
#                genuine one-off admin tasks (universe creation, etc).
#
# The binaries turned out to be close to fully statically linked (`ldd`:
# only libm, libresolv, libc, the dynamic linker -- no libc++, no libsqlite3,
# both statically bundled per Dockerfile.builder's link flags). Runtime base
# only needs to be glibc-compatible with the builder image, which is
# Debian-testing-based -- debian:trixie-slim is the matching runtime family.

ARG BUILDER_DIGEST=sha256:79611d08e671ba4a75b01a96331251b7d27b267e42de74e58c89fa0d14ada5c6

# Build context for this stage is expected to be a galactic-bloodshed source
# checkout with ../build/toolchain-clang22-libcxx22.cmake copied in as
# gb-toolchain.cmake at its root (see build-runtime.sh, which does exactly
# that rather than requiring a fragile multi-context build invocation).
FROM ghcr.io/kaladron/cpp-image/dev-env@${BUILDER_DIGEST} AS build
USER root
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends ninja-build libsqlite3-dev \
 && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /lib/share/libc++ && rm -rf /lib/share/libc++/v1 \
 && ln -s /usr/lib/llvm-22/share/libc++/v1 /lib/share/libc++/v1
COPY . /workspace/
WORKDIR /workspace
RUN cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release --toolchain /workspace/gb-toolchain.cmake \
 && cmake --build build --target GB makeuniv enrol racegen -j"$(nproc)" \
 && cmake --install build
# No --prefix override: PKGDATADIR (where the game looks for star.list/
# planet.list/ship.dat/exam.dat/help/*.md at runtime) is baked into the
# binary AT CONFIGURE TIME from CMAKE_INSTALL_PREFIX (default /usr/local --
# see gb/CMakeLists.txt), so `cmake --install` must land in that SAME
# /usr/local for the binary to find its own data files. Installing to a
# different staging prefix here would silently produce a binary looking in
# the wrong place -- this bit us once already (see the slice report).

# ------------------------------------------------------------- gb-server
FROM debian:trixie-slim AS gb-server
RUN groupadd -r -g 9010 galacticbloodshed && useradd -r -u 9010 -g galacticbloodshed -M -s /usr/sbin/nologin galacticbloodshed
COPY --from=build /usr/local/bin/GB /usr/local/bin/GB
COPY --from=build /usr/local/share/galactic-bloodshed /usr/local/share/galactic-bloodshed
# Persistent universe lives on a mounted volume, never in the image layer.
RUN mkdir -p /var/lib/galactic-bloodshed && chown galacticbloodshed:galacticbloodshed /var/lib/galactic-bloodshed
VOLUME ["/var/lib/galactic-bloodshed"]
USER galacticbloodshed:galacticbloodshed
WORKDIR /var/lib/galactic-bloodshed
EXPOSE 2010
ENTRYPOINT ["/usr/local/bin/GB", "--db", "/var/lib/galactic-bloodshed/gb.db"]
CMD ["--port", "2010"]

# ---------------------------------------------- gb-admin / provisioner
# makeuniv/enrol/racegen (one-off admin use) + gb_provisiond.py, the narrow
# provisioning daemon that IS this image's long-running default process.
# Same UID as gb-server (9010) -- see the ownership model in the parent
# slice report: both containers legitimately write the same SQLite database,
# and the existing L33TEST convention (see /root/binktermphp/state/multizork
# on the host) is single-owner-UID directories, not shared-group chmod
# tricks, so both containers simply run as the identical service UID.
FROM debian:trixie-slim AS gb-admin
RUN groupadd -r -g 9010 galacticbloodshed && useradd -r -u 9010 -g galacticbloodshed -M -s /usr/sbin/nologin galacticbloodshed
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends python3 \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /usr/local/bin/makeuniv /usr/local/bin/makeuniv
COPY --from=build /usr/local/bin/enrol /usr/local/bin/enrol
COPY --from=build /usr/local/bin/racegen /usr/local/bin/racegen
COPY --from=build /usr/local/share/galactic-bloodshed /usr/local/share/galactic-bloodshed
COPY gb_provisiond.py /usr/local/bin/gb_provisiond.py
RUN mkdir -p /var/lib/galactic-bloodshed && chown galacticbloodshed:galacticbloodshed /var/lib/galactic-bloodshed
VOLUME ["/var/lib/galactic-bloodshed"]
USER galacticbloodshed:galacticbloodshed
WORKDIR /var/lib/galactic-bloodshed
ENV GB_ENROL_BIN=/usr/local/bin/enrol
ENV GB_DB_PATH=/var/lib/galactic-bloodshed/gb.db
ENTRYPOINT ["python3", "/usr/local/bin/gb_provisiond.py"]
# One-off admin invocations override the entrypoint, e.g.:
#   docker run --rm -v <same-volume>:/var/lib/galactic-bloodshed \
#     --entrypoint /usr/local/bin/makeuniv l33test/galactic-bloodshed-admin ...
