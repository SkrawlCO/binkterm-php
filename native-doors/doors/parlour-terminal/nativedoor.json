{
  "type": "nativedoor",
  "version": "1.0",
  "game": {
    "name": "Parlour",
    "short_name": "PARLOUR",
    "author": "Braedon Saunders (canonical Parlour); Crossroads adapters",
    "description": "The full 23-game Parlour card room in classic 80x24 terminal form: solitaire, trick-taking, shedding, meld, and special games, solo or against bots, with your progress saved.",
    "genre": [
      "Card"
    ],
    "players": "Single-player"
  },
  "door": {
    "executable": "cli.ts",
    "launch_command": "/usr/bin/env -i PATH=/usr/local/bin:/usr/bin:/bin TERM=xterm-256color DOOR_USER_NUMBER={user_number} /var/www/html/shared/parlour/node_modules/.bin/tsx /var/www/html/shared/parlour/terminal/src/cli.ts",
    "dropfile_format": "DOOR.SYS",
    "output_encoding": "utf8",
    "terminal_mode": "raw",
    "ansi_required": true,
    "max_nodes": 10,
    "time_per_day": 60
  },
  "requirements": {
    "platform": [
      "linux"
    ]
  },
  "experience": {
    "group": "parlour",
    "surface": "telnet",
    "primary": false
  },
  "config": {
    "enabled": false,
    "credit_cost": 0,
    "max_time_minutes": 60,
    "max_sessions": 10,
    "allow_anonymous": false,
    "guest_max_sessions": 0,
    "terminal_size": "80x24"
  }
}
