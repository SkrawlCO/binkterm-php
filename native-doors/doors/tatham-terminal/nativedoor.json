{
  "type": "nativedoor",
  "version": "1.0",
  "game": {
    "name": "Tatham Puzzles",
    "short_name": "TATHAM",
    "author": "Simon Tatham and contributors; L33TEST frontend glue",
    "description": "Light Up, the initial Tatham puzzle. Shared progress with the Web surface.",
    "genre": [
      "Puzzle"
    ],
    "players": "Single-player"
  },
  "door": {
    "executable": "play.py",
    "launch_command": "/usr/bin/env -i PATH=/usr/local/bin:/usr/bin:/bin TERM=xterm-256color DOOR_USER_NUMBER={user_number} /usr/bin/python3 -B play.py",
    "dropfile_format": "DOOR.SYS",
    "output_encoding": "utf8",
    "terminal_mode": "raw",
    "ansi_required": true,
    "max_nodes": 10,
    "time_per_day": 60
  },
  "requirements": {
    "admin_only": true,
    "platform": [
      "linux"
    ]
  },
  "experience": {
    "group": "tatham",
    "surface": "telnet",
    "primary": false
  },
  "config": {
    "enabled": false,
    "credit_cost": 0,
    "max_time_minutes": 60,
    "max_sessions": 10,
    "allow_anonymous": false,
    "guest_max_sessions": 0,
    "terminal_size": "80x24"
  }
}
